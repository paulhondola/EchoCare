<?xml version="1.0" encoding="utf-8"?>
<!-- No app data in Auto Backup (Android 11 and older): a restored Firebase session would sign
     someone in on another device (design 2026-11-14). allowBackup is false as well. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

# Copy to backend/.env (not committed). Compose overrides DATABASE_URL to use its db service.

# Environment Type
APP_ENV=local

# Local DB Connection
DATABASE_URL=postgresql://echocare:echocare@localhost:5432/echocare

# The ngrok tunnel (ADR-001): your account's dev domain, for Twilio callbacks
PUBLIC_BASE_URL=https://your-domain.ngrok-free.dev

# CORS. A local API also allows http://localhost:5173 and http://127.0.0.1:5173
ALLOWED_ORIGIN=http://localhost:5173

SCHEDULER_ENABLED=true
DEMO_MODE=true

# Twilio (04 §4): from the console; the number is the one bought for the project, a Romanian (+40…) one
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The account's Voice API host; Ireland (IE1) is api.dublin.ie1.twilio.com, with its own auth token
TWILIO_API_HOST=api.twilio.com
# Calls live at once; the trial account's limit
MAX_LIVE_CALLS=3
# Who the scheduler may dial: comma-separated numbers; empty dials nobody, * everyone
DIAL_ALLOWLIST=

# ConversationRelay's voice (04 §4.3); which one sounds right is spike S1
# TWILIO_TTS_PROVIDER=Google
# TWILIO_VOICE=ro-RO-Wavenet-A

# Firebase Connection
FIREBASE_WEB_API_KEY=

# S3-compatible storage bucket
# Local MinIO defaults (runs on docker compose up):
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET_NAME=echocare
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_REGION=ams
#
# Railway cloud storage (injected automatically in Railway):
S3_BUCKET_NAME=
S3_ENDPOINT=
# Host in presigned URLs when clients can't reach S3_ENDPOINT (Compose: localhost:9000); empty means S3_ENDPOINT
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ams

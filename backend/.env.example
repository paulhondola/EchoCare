# Copy to backend/.env (not committed). Compose overrides DATABASE_URL to use its db service.

# Environment Type
APP_ENV=local

# Local DB Connection
DATABASE_URL=postgresql://echocare:echocare@localhost:5432/echocare

# NGROK Tunnel Connection
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app
ALLOWED_ORIGIN=http://localhost:5173


SCHEDULER_ENABLED=true
DEMO_MODE=true


# Twilio (04 §4): from the console; the number is the one bought for the project, +1…
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ConversationRelay's voice (04 §4.3); which one sounds right is spike S1
# TWILIO_TTS_PROVIDER=Google
# TWILIO_VOICE=ro-RO-Wavenet-A

# Firebase Connection
FIREBASE_WEB_API_KEY=

# S3-compatible storage bucket
# Local MinIO defaults (runs on docker compose up):
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET_NAME=echocare
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_REGION=ams
#
# Railway cloud storage (injected automatically in Railway):
S3_BUCKET_NAME=
S3_ENDPOINT=
# Host in presigned URLs when clients can't reach S3_ENDPOINT (Compose: localhost:9000); empty means S3_ENDPOINT
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ams

# Copy to backend/.env (not committed). Compose overrides DATABASE_URL to use its db service.
APP_ENV=local
DATABASE_URL=postgresql://sentinela:sentinela@localhost:5432/sentinela
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app
ALLOWED_ORIGIN=http://localhost:5173
SCHEDULER_ENABLED=true
DEMO_MODE=true
# Twilio (04 §4): from the console; the number is the one bought for the project, +1…
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# ConversationRelay's voice (04 §4.3); which one sounds right is spike S1
# TWILIO_TTS_PROVIDER=Google
# TWILIO_VOICE=ro-RO-Wavenet-A
FIREBASE_WEB_API_KEY=
# S3-compatible storage bucket (Railway or local MinIO)
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ams

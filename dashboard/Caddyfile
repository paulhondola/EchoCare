{
	admin off
	persist_config off
	# Railway terminates TLS at its edge
	auto_https off
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

# On every response, errors included (design 2026-11-14). No script CSP: Firebase phone
# sign-in loads reCAPTCHA from Google's domains; frame-ancestors only blocks framing.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# No includeSubDomains: the dashboard lives on a Railway subdomain
		Strict-Transport-Security "max-age=31536000"
	}
}

:{$PORT:3000} {
	import security_headers
	root * /srv
	encode gzip

	# SvelteKit puts a content hash in these names, so a changed file gets a new URL: cache for a year.
	# No fallback here: a missing asset is a 404, never index.html cached under a script's URL.
	@assets path /_app/immutable/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else, index.html included, is revalidated on every load, so a deploy shows at once.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Never cache an error: during a deploy's overlap, an asset can 404 on the old copy for a moment.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

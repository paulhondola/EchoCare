# Copy to dashboard/.env (not committed). Vite exposes only VITE_* variables to the browser.
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional. true signs in with real numbers and real SMS on the dev server, behind a reCAPTCHA; leave it out for Firebase test numbers.
VITE_REAL_SMS=
